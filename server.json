{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.zamansheikh/memory-lean",
  "description": "Token-lean memory for AI agents: a knowledge graph searched cheaply. Drop-in for server-memory.",
  "repository": {
    "url": "https://github.com/zamansheikh/memory-lean",
    "source": "github"
  },
  "version": "1.4.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "memory-lean",
      "version": "1.4.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MEMORY_FILE_PATH",
          "description": "Where the graph file lives (default ~/.claude/memory-graph/memory.jsonl)",
          "isRequired": false,
          "format": "filepath"
        }
      ]
    }
  ]
}
